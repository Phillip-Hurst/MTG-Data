*.skill
*.plugin

# Dev/probe scripts and local-only helpers (kept out of the public skill too)
probe_page.py
probe_melee.py
probe_log.txt
run_log.txt
# Cloudflare-blocked failed experiment, never publish
mtgdecks_fetch.py
# hardcoded to specific tournament IDs; stays local, not shipped in the .skill
analyze_weekend.py

# Personal vault notes, analysis output, and registries — never publish these
# Two subtleties here, both learned the hard way on 2026-08-29:
#  - the brackets are escaped because gitignore reads [C] as a character class;
#    unescaped it matches a file starting "C ", not "[C] "
#  - the leading slash anchors it to the repo root. Unanchored it matched at
#    every level and silently excluded the 25 shipped archetype notes in
#    skills/mtg-tournament-analysis/reference/archetypes/, which are the
#    canonical vocabulary and very much meant to publish.
/\[C\] *.md
mtgo_deck_log.md
melee_win_rate_tracker.md
standings_only_events.json
mtg_workspace.json

# Per-format scrape workspace created by setup.py (if it lands beside the repo)
/MTG Skill/
/MTG Data/

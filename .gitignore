baselines/
*.json.bak

# Generated per-run reports and caches (2026-08-29). All regenerable:
# card_pool_* from Scryfall, event_quarantine_* from validate_events.py.
# archetype_overrides.json holds this user's own deck-label rulings — personal,
# and it lives in the OneDrive-synced vault, so it doesn't belong in a public repo.
card_pool_*.json
event_quarantine_*.json
archetype_overrides.json
archetype_refs.pre-alias.json
*.quarantined.csv
*.raw.csv


# Frozen previous-era data written by archive_era.py — same reasoning as the
# live CSVs, just older. The manifest goes with it.
archive/

# Transcripts — large, personal
transcripts/

# Comprehensive Rules cache, downloaded by rules_lookup.py. About 1 MB, and it
# is superseded with every set release, so a committed copy is a stale copy.
# The .version stamp goes with it: a stamp without its document makes
# `rules_lookup.py --version` report a CR the cache doesn't contain.
comp_rules_cache.txt
comp_rules_cache.version

